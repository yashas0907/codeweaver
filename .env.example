# Project configuration. Copy to .env and adjust. NEVER commit real .env files.

# --- Application ---
CODEWEAVER_HOST=127.0.0.1
CODEWEAVER_PORT=8600
CODEWEAVER_DATA_DIR=./data
CODEWEAVER_WORKSPACE_ROOT=./data/workspaces
CODEWEAVER_DB_URL=sqlite+aiosqlite:///./data/forgeai.db

# --- Agent ---
# READ_ONLY or WORKSPACE_EDIT
CODEWEAVER_AGENT_MODE=WORKSPACE_EDIT
CODEWEAVER_MAX_REPAIR_ITERATIONS=3
CODEWEAVER_MAX_TEST_TIMEOUT_SECONDS=300
CODEWEAVER_MAX_TOOL_TIMEOUT_SECONDS=120
# Max context characters handed to the LLM in one prompt
CODEWEAVER_MAX_CONTEXT_CHARS=48000

# --- LLM provider ---
# "deterministic" ships with this project: a rule-based reasoning engine, no API key needed.
# "http_compatible" connects to any HTTP chat-completions endpoint (self-hosted or hosted).
# "none" disables all LLM calls; deterministic phases fall back to rule-based behavior.
#
# RECOMMENDED FREE SETUP — Groq free tier (no credit card, instant sign-up):
#   1. Get your free key at https://console.groq.com/keys
#   2. Set CODEWEAVER_LLM_API_KEY=your_key_here
#   3. Everything below is pre-configured for Groq's free tier automatically.
#
CODEWEAVER_LLM_PROVIDER=deterministic
CODEWEAVER_LLM_MODEL=llama-3.3-70b-versatile
CODEWEAVER_LLM_BASE_URL=https://api.groq.com/openai/v1
CODEWEAVER_LLM_API_KEY_ENV=CODEWEAVER_LLM_API_KEY
CODEWEAVER_LLM_TEMPERATURE=0.2
CODEWEAVER_LLM_MAX_TOKENS=4096
CODEWEAVER_LLM_TIMEOUT_SECONDS=120
CODEWEAVER_LLM_MAX_RETRIES=2
# Add your free Groq API key here (or set the CODEWEAVER_LLM_API_KEY env var):
CODEWEAVER_LLM_API_KEY=

# --- GitHub adapter ---
# Works unauthenticated for public repos; set a token env var name for higher rate limits.
CODEWEAVER_GITHUB_TOKEN_ENV=CODEWEAVER_GITHUB_TOKEN

# --- Security ---
CODEWEAVER_ALLOW_NETWORK_TOOLS=true